{
  "name": "dc-cup-3ra-edicion-control-maestro",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c yellow,cyan \"node --watch server/index.js\" \"npm run dev --workspace client\"",
    "start": "node server/index.js",
    "build": "npm run build --workspace client",
    "check": "node --check server/index.js && node --check server/database.js && npm run build",
    "test": "node --test server/*.test.js",
    "reset-admin": "node server/reset-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
